                "panel"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4. Cifrado en reposo AES-256-GCM",
      "item": [
        {
          "name": "Probar cifrado (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/cifrado/probar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "cifrado",
                "probar"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Carnet 7654321 LP - dato sensible\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "5. Bitácora de auditoría",
      "item": [
        {
          "name": "Toda la bitácora (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auditoria",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auditoria"
              ]
            }
          }
        },
        {
          "name": "Solo logins fallidos (ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenAdmin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auditoria?accion=LOGIN_FALLIDO",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auditoria"
              ],
              "query": [
                {
                  "key": "accion",
                  "value": "LOGIN_FALLIDO"
                }
              ]
            }
          }
        },
        {
          "name": "Bitácora con token ENCARGADO (403)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenEncargado}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auditoria",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auditoria"
              ]
            }
          }
        }
      ]
